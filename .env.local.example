# Admin ingestion (required for /admin)
ADMIN_INGEST_ENABLED=false
ADMIN_SESSION_SECRET=

# Optional secret unlock (disabled unless explicitly allowed)
# ADMIN_INGEST_ALLOW_SECRET=true
# ADMIN_INGEST_SECRET=

# GitHub OAuth admin login
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CALLBACK_URL=
# GITHUB_ADMIN_ALLOWLIST=your-github-login

# GitHub archive storage (metadata/manifests; durable SoT on Vercel)
# GITHUB_ARCHIVE_TOKEN=
# GITHUB_ARCHIVE_OWNER=
# GITHUB_ARCHIVE_REPO=
# GITHUB_ARCHIVE_BRANCH=main
# GITHUB_ARCHIVE_DURABLE=1

# Cloudflare R2 binary media (server-only secrets — never expose to the browser)
# R2_ARCHIVE_ENABLED=true
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ENDPOINT=
# R2_UPLOAD_TTL_SECONDS=600

# Optional: trigger redeploy after metadata commit
# VERCEL_DEPLOY_HOOK_URL=

# -----------------------------------------------------------------------------
# R2 bucket CORS (Cloudflare dashboard → R2 → bucket → Settings → CORS Policy)
# -----------------------------------------------------------------------------
# Browser upload sends: method PUT, header Content-Type only (no Content-Length).
# Do NOT use a broad https://*.vercel.app origin unless Cloudflare CORS for this
# bucket explicitly supports that wildcard in your account. Prefer listing each
# preview hostname you use, or a single dedicated preview domain.
#
# Example policy (narrow origins — replace hosts as needed):
#
# [
#   {
#     "AllowedOrigins": [
#       "http://localhost:3000",
#       "https://anekaroopam.art",
#       "https://www.anekaroopam.art"
#     ],
#     "AllowedMethods": ["PUT", "GET", "HEAD"],
#     "AllowedHeaders": ["Content-Type"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
#
# For a specific Vercel preview hostname, add it explicitly, e.g.:
#   "https://anekaroopam-site-<hash>-<team>.vercel.app"
#
# Public media GETs use R2_PUBLIC_BASE_URL (custom domain / public access) and
# are separate from this upload CORS policy.
#
# Follow-up (not implemented): Retry metadata-only commit UI after R2 success.
